#!/usr/bin/env python3
import os
import shutil
import sys
from pathlib import Path

# Hooks, Rex actions, and worker panes all enter here, often through an older python3.
if sys.version_info < (3, 13):
    python = shutil.which("python3.13")
    if not python or Path(python).resolve() == Path(sys.executable).resolve():
        sys.exit("rex-agents requires Python 3.13 or newer; found %d.%d and no python3.13 on PATH" % sys.version_info[:2])
    os.execv(python, [python, __file__, *sys.argv[1:]])

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from rex_agents.cli import main

raise SystemExit(main())
